From 9160642a5bcdd5ab46d67fb4e9c3ee8d62d058cf Mon Sep 17 00:00:00 2001
From: Hiago De Franco <hfranco@baylibre.com>
Date: Fri, 16 Oct 2026 09:03:49 -0300
Subject: [PATCH] riscv: dts: sophgo: cv1800b-milkv-duo: add ethernet0 alias

Add the ethernet0 alias pointing to gmac0. Bootloaders such as U-Boot
only pass the MAC address to the kernel for nodes referenced by an
"ethernetN" alias.

Without it, a MAC address stored in the bootloader environment (or
randomly generated by U-Boot when none is set) is ignored and the stmmac
driver picks a new random address at every boot.

The alias is added even though gmac0 is disabled in cv180x.dtsi, as the
node is enabled by the board, overlay or user configuration.

Upstream-Status: Pending
Signed-off-by: Hiago De Franco <hfranco@baylibre.com>
---
 arch/riscv/boot/dts/sophgo/cv1800b-milkv-duo.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/riscv/boot/dts/sophgo/cv1800b-milkv-duo.dts b/arch/riscv/boot/dts/sophgo/cv1800b-milkv-duo.dts
index 9d736df9497a..1aab6b5512de 100644
--- a/arch/riscv/boot/dts/sophgo/cv1800b-milkv-duo.dts
+++ b/arch/riscv/boot/dts/sophgo/cv1800b-milkv-duo.dts
@@ -14,6 +14,7 @@ / {
 	compatible = "milkv,duo", "sophgo,cv1800b";
 
 	aliases {
+		ethernet0 = &gmac0;
 		serial0 = &uart0;
 		serial1 = &uart1;
 		serial2 = &uart2;
-- 
