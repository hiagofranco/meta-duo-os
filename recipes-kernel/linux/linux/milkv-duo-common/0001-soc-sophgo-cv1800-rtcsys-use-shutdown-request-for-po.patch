From bfae4169e27614b8db921ba62449b8d741171785 Mon Sep 17 00:00:00 2001
From: Hiago De Franco <hfranco@baylibre.com>
Date: Fri, 16 Oct 2026 09:41:19 -0300
Subject: [PATCH] soc: sophgo: cv1800-rtcsys: use shutdown request for power
 off

pm_power_off was pointed at cv1800_reset(), which issues a warm reset
request, so "poweroff" rebooted the board. Add cv1800_poweroff(), which
enables the shutdown request and sets req_shdn (rtc_ctrl0[0]), matching
the sequence used by U-Boot's cv1800b sysreset driver.

Upstream-Status: Pending
Signed-off-by: Hiago De Franco <hfranco@baylibre.com>
---
 drivers/soc/sophgo/cv1800-rtcsys.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/sophgo/cv1800-rtcsys.c b/drivers/soc/sophgo/cv1800-rtcsys.c
index ca565325e47e..f54647d1de1f 100644
--- a/drivers/soc/sophgo/cv1800-rtcsys.c
+++ b/drivers/soc/sophgo/cv1800-rtcsys.c
@@ -50,6 +50,19 @@ static void cv1800_reset(void)
 	writel(0xFFFF0800 | (0x1 << 4), REG_RTC_CTRL_BASE + RTC_CTRL0);
 }
 
+static void cv1800_poweroff(void)
+{
+	void __iomem *REG_RTC_CTRL_BASE = base;
+	void __iomem *REG_RTC_BASE = base + 0x1000;
+
+	writel(0x1, REG_RTC_BASE + RTC_EN_SHDN_REQ);
+
+	writel(0xAB18, REG_RTC_CTRL_BASE + RTC_CTRL0_UNLOCKKEY);
+
+	/* req_shdn = rtc_ctrl0[0] */
+	writel(0xFFFF0800 | (0x1 << 0), REG_RTC_CTRL_BASE + RTC_CTRL0);
+}
+
 static int cv1800_restart_handler(struct notifier_block *this,
 				unsigned long mode, void *cmd)
 {
@@ -110,7 +123,7 @@ static int cv1800_rtcsys_probe(struct platform_device *pdev)
 		goto unmap;
 	}
 
-	pm_power_off = cv1800_reset;
+	pm_power_off = cv1800_poweroff;
 
 	return 0;
 
-- 
